pipeline {
    agent any

    environment {
        SERVICE_NAME = 'api-gateway'
        // AWS & ECR Credentials 바인딩
        ECR_REGISTRY = credentials('ECR_REGISTRY')
        AWS_REGION = credentials('AWS_REGION')
        // API Gateway 환경변수 바인딩
        REDIS_HOST = credentials('REDIS_HOST')
        REDIS_PORT = credentials('REDIS_PORT')
        JWT_KEY = credentials('JWT_KEY')

        // 이미지 태그 설정
        IMAGE_TAG = "api-gateway-${BUILD_NUMBER}"
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Build') {
            steps {
                dir('api-gateway') {
                    sh '''
                        chmod +x gradlew
                        ./gradlew clean build -x test
                    '''
                }
            }
        }

        stage('Test') {
            steps {
                dir('api-gateway') {
                    sh './gradlew test'
                }
            }
        }

        stage('ECR Login & Docker Build') {
            steps {
                script {
                    // AWS ECR 로그인
                    sh "aws ecr get-login-password --region ${AWS_REGION} | docker login --username AWS --password-stdin ${ECR_REGISTRY}"

                    dir('api-gateway') {
                        // Docker 이미지 빌드
                        docker.build("${ECR_REGISTRY}:${IMAGE_TAG}",
                            "--build-arg REDIS_HOST=${REDIS_HOST} " +
                            "--build-arg REDIS_PORT=${REDIS_PORT} " +
                            "--build-arg JWT_KEY=${JWT_KEY} .")
                    }
                }
            }
        }

        stage('Push to ECR') {
            steps {
                script {
                    sh "docker push ${ECR_REGISTRY}:${IMAGE_TAG}"
                }
            }
        }

        stage('Deploy to ECS') {
            steps {
                script {
                    sh """
                        aws ecs update-service \
                            --cluster jari-otte \
                            --service ${SERVICE_NAME} \
                            --force-new-deployment \
                            --region ${AWS_REGION}
                    """
                }
            }
        }
    }

    post {
        success {
            echo "Pipeline Successfully Completed"
            echo "Built and Deployed Image: ${ECR_REGISTRY}:${IMAGE_TAG}"
        }
        failure {
            echo "Pipeline Failed"
        }
    }
}