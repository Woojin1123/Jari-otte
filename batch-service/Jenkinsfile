pipeline {
    agent any
    environment {
        DOCKER_IMAGE = "your-dockerhub-username/batch-service"
        REDIS_HOST = credentials('REDIS_HOST')
        REDIS_PORT = credentials('REDIS_PORT')
        DB_URL_BATCH = credentials('DB_URL_BATCH')
        DB_USER = credentials('DB_USER')
        DB_PASSWORD = credentials('DB_PASSWORD')
        EUREKA_URL = credentials('EUREKA_URL')
    }
    stages {
        stage('Check Branch') {
            when {
                branch 'main'
            }
            steps {
                echo "Push event detected on 'main' branch"
            }
        }
        stage('Clone Repository') {
            steps {
                checkout scm
            }
        }
        stage('Build') {
            steps {
                sh '''
                    chmod +x gradlew
                    ./gradlew clean build -x test
                '''
            }
        }
        stage('Docker Build and Push') {
            environment {
                DOCKER_CREDENTIALS = credentials('docker-credentials')
            }
            steps {
                sh '''
                    docker login -u ${DOCKER_CREDENTIALS_USR} -p ${DOCKER_CREDENTIALS_PSW}
                    docker build -t ${DOCKER_IMAGE} .
                    docker push ${DOCKER_IMAGE}
                '''
            }
        }
        stage('Deploy') {
            steps {
                sh '''
                    docker stop batch-service || true
                    docker rm batch-service || true
                    docker run -d --name batch-service \
                    -p 8089:8089 \
                    -e REDIS_HOST=${REDIS_HOST} \
                    -e REDIS_PORT=${REDIS_PORT} \
                    -e DB_URL_BATCH=${DB_URL_BATCH} \
                    -e DB_USER=${DB_USER} \
                    -e DB_PASSWORD=${DB_PASSWORD} \
                    -e EUREKA_URL=${EUREKA_URL} \
                    ${DOCKER_IMAGE}
                '''
            }
        }
    }
    post {
        always {
            sh 'docker logout'
        }
        failure {
            echo 'Pipeline failed'
        }
    }
}