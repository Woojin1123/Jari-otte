def builder = "any"
def dockerImage = "kanguk148/batch-0.0.1"

properties([
    pipelineTriggers([
        githubPush()
    ])
])

node(builder) {
    try {
        stage('변경사항 확인') {
            def changes = sh(script: "git diff --name-only HEAD^", returnStdout: true).trim()
            def serviceChanged = changes.split('\n').any { it.startsWith('batch-service/') }

            if (!serviceChanged) {
                currentBuild.result = 'NOT_BUILT'
                error('batch-service 디렉토리에 변경사항이 없어 빌드를 건너뜁니다.')
            }
            echo "batch-service 디렉토리에서 변경사항이 감지되었습니다. 빌드를 진행합니다..."
        }

        stage('저장소 복제') {
            checkout scm
            def gitCommit = sh(script: 'git rev-parse HEAD', returnStdout: true).trim()
            echo "빌드 커밋: ${gitCommit}"
        }

        stage('실행 권한 부여') {
            sh 'chmod +x gradlew'
        }

        stage('프로젝트 빌드') {
            sh './gradlew clean build -x test'
        }

        stage('도커 이미지 빌드 및 푸시') {
            withCredentials([
                usernamePassword(credentialsId: 'docker-credentials', usernameVariable: 'DOCKER_USER', passwordVariable: 'DOCKER_PASS'),
                string(credentialsId: 'DB_URL_BATCH', variable: 'DB_URL_BATCH'),
                string(credentialsId: 'DB_USER', variable: 'DB_USER'),
                string(credentialsId: 'DB_PASSWORD', variable: 'DB_PASSWORD'),
                string(credentialsId: 'REDIS_HOST', variable: 'REDIS_HOST'),
                string(credentialsId: 'REDIS_PORT', variable: 'REDIS_PORT'),
                string(credentialsId: 'EUREKA_URL', variable: 'EUREKA_URL')
            ]) {
                sh """
                    echo \$DOCKER_PASS | docker login -u \$DOCKER_USER --password-stdin
                    docker build -t ${dockerImage} .
                    docker push ${dockerImage}
                """
            }
        }

        stage('배포') {
            sh """
                docker stop batch-service || true
                docker rm batch-service || true
                docker run -d --name batch-service -p 8089:8089 \
                -e DB_URL_BATCH=\$DB_URL_BATCH \
                -e DB_USER=\$DB_USER \
                -e DB_PASSWORD=\$DB_PASSWORD \
                -e REDIS_HOST=\$REDIS_HOST \
                -e REDIS_PORT=\$REDIS_PORT \
                -e EUREKA_URL=\$EUREKA_URL \
                ${dockerImage}
            """
        }
    } finally {
        sh 'docker logout'
    }
}