FROM openjdk:17-jdk-slim
# 환경변수 정의
ARG EUREKA_URL
ARG DB_URL_CONCERT
ARG DB_URL_CONCERT_SLAVE
ARG DB_USERNAME
ARG DB_PASSWORD
ARG REDIS_HOST
ARG REDIS_PORT
ARG ELASTIC_USERNAME
ARG ELASTIC_PASSWORD
ARG ELASTIC_URL
ARG WEBHOOKS_URL

# 환경변수 설정
ENV WEBHOOKS_URL=${WEBHOOKS_URL}
ENV EUREKA_URL=${EUREKA_URL}
ENV DB_URL_CONCERT=${DB_URL_CONCERT}
ENV DB_URL_CONCERT_SLAVE=${DB_URL_CONCERT_SLAVE}
ENV DB_USERNAME=${DB_USERNAME}
ENV DB_PASSWORD=${DB_PASSWORD}
ENV REDIS_HOST=${REDIS_HOST}
ENV REDIS_PORT=${REDIS_PORT}
ENV ELASTICSEARCH_NAME=${ELASTICSEARCH_NAME}
ENV ELASTICSEARCH_NAME=${ELASTICSEARCH_NAME}
ENV ELASTICSEARCH_URL=${ELASTICSEARCH_URL}

WORKDIR /app

COPY build/libs/concert-service-0.0.1-SNAPSHOT.jar app.jar

EXPOSE 8080

ENTRYPOINT ["java", "-jar", "app.jar"]