pipeline {
    agent any

    environment {
        SERVICE_NAME = 'concert-service'
        ECR_REGISTRY = credentials('ECR_REGISTRY')
        AWS_REGION = credentials('AWS_REGION')
        DB_URL_CONCERT = credentials('DB_URL_CONCERT')
        DB_USERNAME = credentials('DB_USERNAME')
        DB_PASSWORD = credentials('DB_PASSWORD')
        REDIS_HOST = credentials('REDIS_HOST')
        REDIS_PORT = credentials('REDIS_PORT')

        // 이미지 태그 설정
        IMAGE_TAG = "concert-service-${BUILD_NUMBER}"
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Build') {
            steps {
                dir('concert-service') {
                    sh '''
                        chmod +x gradlew
                        ./gradlew clean build -x test
                    '''
                }
            }
        }

        stage('Test') {
            steps {
                dir('concert-service') {
                    sh './gradlew test'
                }
            }
        }

        stage('ECR Login & Docker Build') {
            steps {
                script {
                    // AWS ECR 로그인
                    sh "aws ecr get-login-password --region ${AWS_REGION} | docker login --username AWS --password-stdin ${ECR_REGISTRY}"

                    dir('concert-service') {
                        // Docker 이미지 빌드
                        docker.build("${ECR_REGISTRY}:${IMAGE_TAG}",
                            "--build-arg DB_URL_CONCERT=${DB_URL_CONCERT} " +
                            "--build-arg DB_USERNAME=${DB_USERNAME} " +
                            "--build-arg DB_PASSWORD=${DB_PASSWORD} " +
                            "--build-arg REDIS_HOST=${REDIS_HOST} " +
                            "--build-arg REDIS_PORT=${REDIS_PORT} .")
                    }
                }
            }
        }

        stage('Push to ECR') {
            steps {
                script {
                    sh "docker push ${ECR_REGISTRY}:${IMAGE_TAG}"
                }
            }
        }

        stage('Deploy to ECS') {
            steps {
                script {
                    sh """
                        aws ecs update-service \
                            --cluster jari-otte \
                            --service ${SERVICE_NAME} \
                            --force-new-deployment \
                            --region ${AWS_REGION}
                    """
                }
            }
        }
    }

    post {
        success {
            echo "Pipeline Successfully Completed"
            echo "Built and Deployed Image: ${ECR_REGISTRY}:${IMAGE_TAG}"
        }
        failure {
            echo "Pipeline Failed"
        }
    }
}