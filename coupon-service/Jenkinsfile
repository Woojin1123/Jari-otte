pipeline {
    agent any

    environment {
        SERVICE_NAME = 'coupon-service'
        ECR_REGISTRY = credentials('ECR_REGISTRY')
        AWS_REGION = credentials('AWS_REGION')
        DB_URL_COUPON = credentials('DB_URL_COUPON')
        DB_USERNAME = credentials('DB_USERNAME')
        DB_PASSWORD = credentials('DB_PASSWORD')
        REDIS_HOST = credentials('REDIS_HOST')
        REDIS_PORT = credentials('REDIS_PORT')
        KAFKA_SERVER = credentials('KAFKA_SERVER')
        PACKAGE = credentials('PACKAGE')


        IMAGE_TAG = "coupon-service-${BUILD_NUMBER}"
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Build') {
            steps {
                dir('coupon-service') {
                    sh '''
                        chmod +x gradlew
                        ./gradlew clean build -x test
                    '''
                }
            }
        }

        stage('Test') {
            steps {
                dir('coupon-service') {
                    sh './gradlew test'
                }
            }
        }

        stage('ECR Login & Docker Build') {
            steps {
                script {
                    sh "aws ecr get-login-password --region ${AWS_REGION} | docker login --username AWS --password-stdin ${ECR_REGISTRY}"

                    dir('coupon-service') {
                        docker.build("${ECR_REGISTRY}:${IMAGE_TAG}",
                            "--build-arg DB_URL_COUPON=${DB_URL_COUPON} " +
                            "--build-arg DB_USERNAME=${DB_USERNAME} " +
                            "--build-arg DB_PASSWORD=${DB_PASSWORD} " +
                            "--build-arg REDIS_HOST=${REDIS_HOST} " +
                            "--build-arg REDIS_PORT=${REDIS_PORT} " +
                            "--build-arg KAFKA_SERVER=${KAFKA_SERVER} " +
                            "--build-arg PACKAGE=${PACKAGE} .")
                    }
                }
            }
        }

        stage('Push to ECR') {
            steps {
                script {
                    sh "docker push ${ECR_REGISTRY}:${IMAGE_TAG}"
                }
            }
        }

        stage('Deploy to ECS') {
            steps {
                script {
                    sh """
                        aws ecs update-service \
                            --cluster jari-otte \
                            --service ${SERVICE_NAME} \
                            --force-new-deployment \
                            --region ${AWS_REGION}
                    """
                }
            }
        }
    }

    post {
        success {
            echo "Pipeline Successfully Completed"
            echo "Built and Deployed Image: ${ECR_REGISTRY}:${IMAGE_TAG}"
        }
        failure {
            echo "Pipeline Failed"
        }
    }
}