pipeline {
    agent any

    triggers {
        githubPush()
    }

    environment {
        SERVICE_NAME = 'notification-service'
        ECR_REGISTRY = credentials('ECR_REGISTRY')
        AWS_REGION = credentials('AWS_REGION')
        KAFKA_SERVER = credentials('KAFKA_SERVER')
        MAIL_USERNAME = credentials('MAIL_USERNAME')
        MAIL_PASSWORD = credentials('MAIL_PASSWORD')
        IMAGE_TAG = "notification-service-${BUILD_NUMBER}"
    }

    stages {
        stage('Check Changes') {
            steps {
                script {
                    // 변경된 파일 목록 가져오기
                    def changes = sh(script: "git diff --name-only HEAD^", returnStdout: true).trim()

                    // notification-service 디렉토리의 변경사항이 있는지 확인
                    def serviceChanged = changes.split('\n').any { it.startsWith('notification-service/') }

                    if (!serviceChanged) {
                        currentBuild.result = 'NOT_BUILT'
                        error('No changes in notification-service directory, skipping build')
                    }
                    echo "Changes detected in notification-service directory. Proceeding with build..."
                }
            }
        }

        stage('Checkout') {
            steps {
                git branch: 'release/v2',
                    url: 'https://github.com/Eat-pizza-quickly/Jari-otte'

                script {
                    def gitCommit = sh(script: 'git rev-parse HEAD', returnStdout: true).trim()
                    echo "Building commit: ${gitCommit}"
                }
            }
        }

        stage('Build') {
            steps {
                dir('notification-service') {
                    sh '''
                        chmod +x gradlew
                        ./gradlew clean build -x test
                    '''
                }
            }
            post {
                success {
                    echo "Build stage completed successfully"
                }
                failure {
                    error "Build stage failed"
                }
            }
        }

        stage('Test') {
            steps {
                dir('notification-service') {
                    sh './gradlew test'
                }
            }
            post {
                success {
                    echo "Tests completed successfully"
                }
                failure {
                    error "Tests failed"
                }
            }
        }

        stage('ECR Login & Docker Build') {
            steps {
                script {
                    // AWS ECR 로그인
                    sh "aws ecr get-login-password --region ${AWS_REGION} | docker login --username AWS --password-stdin ${ECR_REGISTRY}"

                    dir('notification-service') {
                        // Dockerfile 존재 확인
                        if (!fileExists('Dockerfile')) {
                            error 'Dockerfile not found'
                        }

                        // Docker 이미지 빌드
                        docker.build("${ECR_REGISTRY}:${IMAGE_TAG}",
                            "--build-arg KAFKA_SERVER=${KAFKA_SERVER} " +
                            "--build-arg MAIL_USERNAME=${MAIL_USERNAME} " +
                            "--build-arg MAIL_PASSWORD=${MAIL_PASSWORD} .")

                        // latest 태그도 추가
                        docker.build("${ECR_REGISTRY}:notification-service-latest",
                            "--build-arg KAFKA_SERVER=${KAFKA_SERVER} " +
                            "--build-arg MAIL_USERNAME=${MAIL_USERNAME} " +
                            "--build-arg MAIL_PASSWORD=${MAIL_PASSWORD} .")
                    }
                }
            }
        }

        stage('Push to ECR') {
            steps {
                script {
                    // 버전 태그와 latest 태그 모두 푸시
                    sh """
                        docker push ${ECR_REGISTRY}:${IMAGE_TAG}
                        docker push ${ECR_REGISTRY}:notification-service-latest
                    """
                }
            }
        }

        stage('Deploy to ECS') {
            steps {
                script {
                    sh """
                        aws ecs update-service \
                            --cluster jari-otte \
                            --service ${SERVICE_NAME} \
                            --force-new-deployment \
                            --region ${AWS_REGION}
                    """
                }
            }
            post {
                success {
                    echo "Deployment to ECS completed successfully"
                }
                failure {
                    error "Deployment to ECS failed"
                }
            }
        }
    }

    post {
        success {
            echo """
            ===========================================
            Pipeline Successfully Completed
            Service: ${SERVICE_NAME}
            Image: ${ECR_REGISTRY}:${IMAGE_TAG}
            Latest Image: ${ECR_REGISTRY}:notification-service-latest
            ===========================================
            """
        }
        failure {
            echo """
            ===========================================
            Pipeline Failed
            Service: ${SERVICE_NAME}
            Stage: ${currentBuild.result}
            ===========================================
            """
        }
        always {
            // 작업 완료 후 정리
            cleanWs()
        }
    }
}