FROM openjdk:17-jdk-slim
# 환경변수 정의
ARG DB_URL_RESERVATION
ARG DB_USERNAME
ARG DB_PASSWORD
ARG KAFKA_SERVER
ARG PAYMENT_URL
ARG PAYMENT_CLIENT_KEY
ARG PAYMENT_SECRET_KEY
ARG PAYMENT_SUCCESS_URL
ARG PAYMENT_FAIL_URL

# 환경변수 설정
ENV DB_URL_RESERVATION=${DB_URL_RESERVATION}
ENV DB_USERNAME=${DB_USERNAME}
ENV DB_PASSWORD=${DB_PASSWORD}
ENV KAFKA_SERVER=${KAFKA_SERVER}
ENV PAYMENT_URL=${PAYMENT_URL}
ENV PAYMENT_CLIENT_KEY=${PAYMENT_CLIENT_KEY}
ENV PAYMENT_SECRET_KEY=${PAYMENT_SECRET_KEY}
ENV PAYMENT_SUCCESS_URL=${PAYMENT_SUCCESS_URL}
ENV PAYMENT_FAIL_URL=${PAYMENT_FAIL_URL}

WORKDIR /app

COPY build/libs/reservation-service-0.0.1-SNAPSHOT.jar app.jar

EXPOSE 8082

ENTRYPOINT ["java", "-jar", "app.jar"]