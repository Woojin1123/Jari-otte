pipeline {
    agent any

    environment {
        SERVICE_NAME = 'reservation-service'
        ECR_REGISTRY = credentials('ECR_REGISTRY')
        AWS_REGION = credentials('AWS_REGION')
        DB_URL_RESERVATION = credentials('DB_URL_RESERVATION')
        DB_USERNAME = credentials('DB_USERNAME')
        DB_PASSWORD = credentials('DB_PASSWORD')
        KAFKA_SERVER = credentials('KAFKA_SERVER')
        PAYMENT_URL = credentials('PAYMENT_URL')
        PAYMENT_CLIENT_KEY = credentials('PAYMENT_CLIENT_KEY')
        PAYMENT_SECRET_KEY = credentials('PAYMENT_SECRET_KEY')
        PAYMENT_SUCCESS_URL = credentials('PAYMENT_SUCCESS_URL')
        PAYMENT_FAIL_URL = credentials('PAYMENT_FAIL_URL')
        IMAGE_TAG = "reservation-service-${BUILD_NUMBER}"
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Build') {
            steps {
                dir('reservation-service') {
                    sh '''
                        chmod +x gradlew
                        ./gradlew clean build -x test
                    '''
                }
            }
        }

        stage('Test') {
            steps {
                dir('reservation-service') {
                    sh './gradlew test'
                }
            }
        }

        stage('ECR Login & Docker Build') {
            steps {
                script {
                    sh "aws ecr get-login-password --region ${AWS_REGION} | docker login --username AWS --password-stdin ${ECR_REGISTRY}"

                    dir('reservation-service') {
                        docker.build("${ECR_REGISTRY}:${IMAGE_TAG}",
                            "--build-arg DB_URL_RESERVATION=${DB_URL_RESERVATION} " +
                            "--build-arg DB_USERNAME=${DB_USERNAME} " +
                            "--build-arg DB_PASSWORD=${DB_PASSWORD} " +
                            "--build-arg KAFKA_SERVER=${KAFKA_SERVER} " +
                            "--build-arg PAYMENT_URL=${PAYMENT_URL} " +
                            "--build-arg PAYMENT_CLIENT_KEY=${PAYMENT_CLIENT_KEY} " +
                            "--build-arg PAYMENT_SECRET_KEY=${PAYMENT_SECRET_KEY} " +
                            "--build-arg PAYMENT_SUCCESS_URL=${PAYMENT_SUCCESS_URL} " +
                            "--build-arg PAYMENT_FAIL_URL=${PAYMENT_FAIL_URL} .")
                    }
                }
            }
        }

        stage('Push to ECR') {
            steps {
                script {
                    sh "docker push ${ECR_REGISTRY}:${IMAGE_TAG}"
                }
            }
        }

        stage('Deploy to ECS') {
            steps {
                script {
                    sh """
                        aws ecs update-service \
                            --cluster jari-otte \
                            --service ${SERVICE_NAME} \
                            --force-new-deployment \
                            --region ${AWS_REGION}
                    """
                }
            }
        }
    }

    post {
        success {
            echo "Pipeline Successfully Completed"
            echo "Built and Deployed Image: ${ECR_REGISTRY}:${IMAGE_TAG}"
        }
        failure {
            echo "Pipeline Failed"
        }
    }
}