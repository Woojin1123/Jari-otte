pipeline {
    agent any

    triggers {
        githubPush()
    }

    environment {
        SERVICE_NAME = 'reservation-service'
        IMAGE_TAG = "reservation-service-latest" // latest 태그만 사용
    }

    stages {
        stage('Prepare Config') {
            steps {
                withCredentials([
                    string(credentialsId: 'WEBHOOKS_URL', variable: 'WEBHOOKS_URL'),
                    string(credentialsId: 'EUREKA_URL', variable: 'EUREKA_URL'),
                    string(credentialsId: 'AWS_ACCESS_KEY_ID', variable: 'AWS_ACCESS_KEY_ID'),
                    string(credentialsId: 'AWS_SECRET_ACCESS_KEY', variable: 'AWS_SECRET_ACCESS_KEY'),
                    string(credentialsId: 'ECR_REGISTRY', variable: 'ECR_REGISTRY'),
                    string(credentialsId: 'AWS_REGION', variable: 'AWS_REGION'),
                    string(credentialsId: 'DB_URL_RESERVATION', variable: 'DB_URL_RESERVATION'),
                    string(credentialsId: 'DB_USERNAME', variable: 'DB_USERNAME'),
                    string(credentialsId: 'DB_PASSWORD', variable: 'DB_PASSWORD'),
                    string(credentialsId: 'KAFKA_SERVER', variable: 'KAFKA_SERVER'),
                    string(credentialsId: 'PAYMENT_URL', variable: 'PAYMENT_URL'),
                    string(credentialsId: 'PAYMENT_CLIENT_KEY', variable: 'PAYMENT_CLIENT_KEY'),
                    string(credentialsId: 'PAYMENT_SECRET_KEY', variable: 'PAYMENT_SECRET_KEY'),
                    string(credentialsId: 'PAYMENT_SUCCESS_URL', variable: 'PAYMENT_SUCCESS_URL'),
                    string(credentialsId: 'PAYMENT_FAIL_URL', variable: 'PAYMENT_FAIL_URL')
                ]) {
                    script {
                        echo "Preparing configuration values..."
                        echo "AWS_REGION: ${AWS_REGION}"
                        echo "ECR_REGISTRY: ${ECR_REGISTRY}"
                        echo "DB_URL_RESERVATION: ${DB_URL_RESERVATION}"
                        echo "KAFKA_SERVER: ${KAFKA_SERVER}"
                        echo "PAYMENT_URL: ${PAYMENT_URL}"

                        // Check essential variables
                        if (!AWS_ACCESS_KEY_ID || !AWS_SECRET_ACCESS_KEY || !ECR_REGISTRY || !AWS_REGION) {
                            error("Essential AWS credentials or registry information is missing.")
                        }

                        if (!DB_URL_RESERVATION || !DB_USERNAME || !DB_PASSWORD || !KAFKA_SERVER || !PAYMENT_URL || !PAYMENT_CLIENT_KEY || !PAYMENT_SECRET_KEY) {
                            error("Database, Kafka, or payment configuration is missing.")
                        }

                        echo "Configuration values successfully loaded and verified."
                    }
                }
            }
        }

        stage('Check Changes') {
            steps {
                script {
                    // 변경된 파일 목록 가져오기
                    def changes = sh(script: "git diff --name-only HEAD^", returnStdout: true).trim()

                    // reservation-service 디렉토리의 변경사항이 있는지 확인
                    def serviceChanged = changes.split('\n').any { it.startsWith('reservation-service/') }

                    if (!serviceChanged) {
                        currentBuild.result = 'NOT_BUILT'
                        error('No changes in reservation-service directory, skipping build')
                    }
                    echo "Changes detected in reservation-service directory. Proceeding with build..."
                }
            }
        }

        stage('Checkout') {
            steps {
                git branch: 'release/v3',
                    url: 'https://github.com/Eat-pizza-quickly/Jari-otte'

                script {
                    def gitCommit = sh(script: 'git rev-parse HEAD', returnStdout: true).trim()
                    echo "Building commit: ${gitCommit}"
                }
            }
        }

        stage('Build') {
            steps {
                dir('reservation-service') {
                    sh '''
                        chmod +x gradlew
                        ./gradlew clean build -x test
                    '''
                }
            }
            post {
                success {
                    echo "Build stage completed successfully"
                }
                failure {
                    error "Build stage failed"
                }
            }
        }

        stage('ECR Login & Docker Build') {
            steps {
                withCredentials([
                    string(credentialsId: 'WEBHOOKS_URL', variable: 'WEBHOOKS_URL'),
                    string(credentialsId: 'EUREKA_URL', variable: 'EUREKA_URL'),
                    string(credentialsId: 'AWS_ACCESS_KEY_ID', variable: 'AWS_ACCESS_KEY_ID'),
                    string(credentialsId: 'AWS_SECRET_ACCESS_KEY', variable: 'AWS_SECRET_ACCESS_KEY'),
                    string(credentialsId: 'ECR_REGISTRY', variable: 'ECR_REGISTRY'),
                    string(credentialsId: 'AWS_REGION', variable: 'AWS_REGION'),
                    string(credentialsId: 'DB_URL_RESERVATION', variable: 'DB_URL_RESERVATION'),
                    string(credentialsId: 'DB_USERNAME', variable: 'DB_USERNAME'),
                    string(credentialsId: 'DB_PASSWORD', variable: 'DB_PASSWORD'),
                    string(credentialsId: 'KAFKA_SERVER', variable: 'KAFKA_SERVER'),
                    string(credentialsId: 'PAYMENT_URL', variable: 'PAYMENT_URL'),
                    string(credentialsId: 'PAYMENT_CLIENT_KEY', variable: 'PAYMENT_CLIENT_KEY'),
                    string(credentialsId: 'PAYMENT_SECRET_KEY', variable: 'PAYMENT_SECRET_KEY'),
                    string(credentialsId: 'PAYMENT_SUCCESS_URL', variable: 'PAYMENT_SUCCESS_URL'),
                    string(credentialsId: 'PAYMENT_FAIL_URL', variable: 'PAYMENT_FAIL_URL')
                ]) {
                    script {
                        // AWS 환경 변수 설정 및 ECR 로그인
                        sh '''
                        export AWS_ACCESS_KEY_ID=$AWS_ACCESS_KEY_ID
                        export AWS_SECRET_ACCESS_KEY=$AWS_SECRET_ACCESS_KEY
                        export AWS_DEFAULT_REGION=$AWS_REGION

                        aws ecr get-login-password --region $AWS_REGION | docker login --username AWS --password-stdin $ECR_REGISTRY
                        '''

                        // Docker 이미지 빌드 및 latest 태그 설정
                        sh '''
                        docker build -t $ECR_REGISTRY:$IMAGE_TAG \
                            --build-arg WEBHOOKS_URL=$WEBHOOKS_URL \
                            --build-arg EUREKA_URL=$EUREKA_URL \
                            --build-arg DB_URL_RESERVATION=$DB_URL_RESERVATION \
                            --build-arg DB_USERNAME=$DB_USERNAME \
                            --build-arg DB_PASSWORD=$DB_PASSWORD \
                            --build-arg KAFKA_SERVER=$KAFKA_SERVER \
                            --build-arg PAYMENT_URL=$PAYMENT_URL \
                            --build-arg PAYMENT_CLIENT_KEY=$PAYMENT_CLIENT_KEY \
                            --build-arg PAYMENT_SECRET_KEY=$PAYMENT_SECRET_KEY \
                            --build-arg PAYMENT_SUCCESS_URL=$PAYMENT_SUCCESS_URL \
                            --build-arg PAYMENT_FAIL_URL=$PAYMENT_FAIL_URL \
                            reservation-service/
                        '''
                    }
                }
            }
        }

        stage('Push to ECR') {
            steps {
                withCredentials([
                    string(credentialsId: 'AWS_ACCESS_KEY_ID', variable: 'AWS_ACCESS_KEY_ID'),
                    string(credentialsId: 'AWS_SECRET_ACCESS_KEY', variable: 'AWS_SECRET_ACCESS_KEY'),
                    string(credentialsId: 'ECR_REGISTRY', variable: 'ECR_REGISTRY'),
                    string(credentialsId: 'AWS_REGION', variable: 'AWS_REGION')
                ]) {
                    script {
                        sh '''
                        export AWS_ACCESS_KEY_ID=$AWS_ACCESS_KEY_ID
                        export AWS_SECRET_ACCESS_KEY=$AWS_SECRET_ACCESS_KEY
                        export AWS_DEFAULT_REGION=$AWS_REGION

                        docker push $ECR_REGISTRY:$IMAGE_TAG
                        '''
                    }
                }
            }
        }

        stage('Deploy to ECS') {
            steps {
                withCredentials([
                    string(credentialsId: 'AWS_ACCESS_KEY_ID', variable: 'AWS_ACCESS_KEY_ID'),
                    string(credentialsId: 'AWS_SECRET_ACCESS_KEY', variable: 'AWS_SECRET_ACCESS_KEY'),
                    string(credentialsId: 'AWS_REGION', variable: 'AWS_REGION')
                ]) {
                    script {
                        sh '''
                        export AWS_ACCESS_KEY_ID=$AWS_ACCESS_KEY_ID
                        export AWS_SECRET_ACCESS_KEY=$AWS_SECRET_ACCESS_KEY
                        export AWS_DEFAULT_REGION=$AWS_REGION

                        aws ecs update-service \
                            --cluster Jari-otte \
                            --service $SERVICE_NAME \
                            --force-new-deployment \
                            --region $AWS_REGION
                        '''
                    }
                }
            }
        }
    }

    post {
        success {
            echo """
            ===========================================
            Pipeline Successfully Completed
            Service: ${SERVICE_NAME}
            Image: ${ECR_REGISTRY}:${IMAGE_TAG}
            ===========================================
            """
        }
        failure {
            echo """
            ===========================================
            Pipeline Failed
            Service: ${SERVICE_NAME}
            Stage: ${currentBuild.result}
            ===========================================
            """
        }
        always {
            // 작업 완료 후 정리
            cleanWs()
        }
    }
}